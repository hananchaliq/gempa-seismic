# SEISMA & Gempa API (gempa.rone.dev) Environment Configuration
# Primary normalised BMKG earthquake & tsunami API (https://gempa.rone.dev/docs)
RONE_GEMPA_API_BASE_URL=https://gempa.rone.dev

# Official upstream earthquake data endpoints (public, no secret keys required)
BMKG_API_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS
USGS_API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1

# Cache & request configuration
SEISMA_FETCH_TIMEOUT_MS=8000
SEISMA_CACHE_TTL_SECONDS=45
